<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:example:derivation"
           elementFormDefault="qualified">
  <xs:element name="Restricted" type="RestrictedIdType"/>
  <xs:element name="Extended" type="ExtendedType"/>

  <xs:complexType name="BaseIdType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="schemeID" type="xs:string"/>
        <xs:attribute name="schemeName" type="xs:string"/>
        <xs:attribute name="schemeAgencyID" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Restates two of the base attributes; they must not appear twice. -->
  <xs:complexType name="RestrictedIdType">
    <xs:simpleContent>
      <xs:restriction base="BaseIdType">
        <xs:attribute name="schemeName" type="xs:normalizedString" use="required"/>
        <xs:attribute name="schemeAgencyID" type="xs:normalizedString"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="BaseBodyType">
    <xs:sequence>
      <xs:element name="First" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- An extension appends, so both elements are expected. -->
  <xs:complexType name="ExtendedType">
    <xs:complexContent>
      <xs:extension base="BaseBodyType">
        <xs:sequence>
          <xs:element name="Second" type="xs:string"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
