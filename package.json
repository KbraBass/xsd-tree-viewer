{
  "name": "xsd-tree-viewer",
  "displayName": "XSD Tree Viewer",
  "description": "Rich, navigable XML Schema previews for Visual Studio Code.",
  "version": "0.2.0",
  "publisher": "xsd-tree-viewer",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "xsd",
    "xml schema",
    "xml",
    "ubl"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:xsd"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "xsdTreeViewer.openPreview",
        "title": "XSD Tree Viewer: Open Preview",
        "icon": "$(preview)"
      },
      {
        "command": "xsdTreeViewer.openPreviewToSide",
        "title": "XSD Tree Viewer: Open Preview to the Side",
        "icon": "$(preview)"
      },
      {
        "command": "xsdTreeViewer.revealInPreview",
        "title": "XSD Tree Viewer: Reveal in Preview"
      },
      {
        "command": "xsdTreeViewer.goToDefinition",
        "title": "XSD Tree Viewer: Go to Definition"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xsdTreeViewer.openPreview",
          "when": "resourceExtname == .xsd || resourceLangId == xml",
          "group": "navigation@50"
        },
        {
          "command": "xsdTreeViewer.openPreviewToSide",
          "when": "resourceExtname == .xsd || resourceLangId == xml",
          "group": "navigation@51"
        }
      ],
      "editor/context": [
        {
          "command": "xsdTreeViewer.revealInPreview",
          "when": "resourceExtname == .xsd || resourceLangId == xml"
        }
      ],
      "explorer/context": [
        {
          "command": "xsdTreeViewer.openPreview",
          "when": "resourceExtname == .xsd",
          "group": "navigation@50"
        }
      ],
      "commandPalette": [
        {
          "command": "xsdTreeViewer.openPreview",
          "when": "resourceExtname == .xsd || resourceLangId == xml"
        },
        {
          "command": "xsdTreeViewer.openPreviewToSide",
          "when": "resourceExtname == .xsd || resourceLangId == xml"
        },
        {
          "command": "xsdTreeViewer.revealInPreview",
          "when": "resourceExtname == .xsd || resourceLangId == xml"
        },
        {
          "command": "xsdTreeViewer.goToDefinition"
        }
      ]
    },
    "configuration": {
      "title": "XSD Tree Viewer",
      "properties": {
        "xsdTreeViewer.autoCollapseDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Number of element levels expanded without a click. Deeper nodes render collapsed and load on demand."
        },
        "xsdTreeViewer.collapseRepeatedSubtrees": {
          "type": "boolean",
          "default": true,
          "description": "Collapse a repeated type's subtree after its first expansions, with a jump link to the first occurrence."
        },
        "xsdTreeViewer.parseCctsAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "Parse structured CCTS documentation used by UBL schemas."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "clean": "node -e \"for (const d of ['dist','out']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "compile": "npm run check && node esbuild.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && npm test && npx vsce package",
    "watch": "node esbuild.js --watch",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test out/test/",
    "test:webview": "node test/webview/keyboard-navigation.mjs"
  },
  "dependencies": {
    "sax": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sax": "^1.2.7",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
